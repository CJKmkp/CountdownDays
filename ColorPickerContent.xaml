<UserControl x:Class="CountdownDays.ColorPickerContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:local="clr-namespace:CountdownDays"
             Width="330">
    <StackPanel>
        <!-- 当前颜色预览 + HEX 输入 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="PreviewSwatch" Width="54" Height="34" CornerRadius="6"
                    Background="#FFFFFF"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{x:Static local:Strings.Hex}"
                           FontSize="11" Opacity="0.6" Margin="0,0,0,3"/>
                <TextBox x:Name="HexBox" Padding="8,5" FontFamily="Consolas"
                         KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus"/>
            </StackPanel>
        </Grid>

        <!-- HSV 交互取色：饱和度/明度方区 + 色相条 -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="SvArea" Width="188" Height="190" CornerRadius="8"
                    ClipToBounds="True" Cursor="Cross"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    MouseLeftButtonDown="SvArea_MouseLeftButtonDown"
                    MouseMove="SvArea_MouseMove"
                    MouseLeftButtonUp="SvArea_MouseLeftButtonUp">
                <Grid>
                    <Border x:Name="HueBaseBorder"/>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle IsHitTestVisible="False">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="Transparent" Offset="0"/>
                                <GradientStop Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse x:Name="SvThumb" Width="16" Height="16"
                             Fill="White" Stroke="#FF000000" StrokeThickness="1.2"
                             IsHitTestVisible="False">
                        <Ellipse.RenderTransform>
                            <TranslateTransform x:Name="SvThumbTransform"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Border>

            <Border Grid.Column="1" x:Name="HueArea" Width="22" Height="190" Margin="14,0,0,0"
                    HorizontalAlignment="Left" CornerRadius="8" ClipToBounds="True" Cursor="Cross"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    MouseLeftButtonDown="HueArea_MouseLeftButtonDown"
                    MouseMove="HueArea_MouseMove"
                    MouseLeftButtonUp="HueArea_MouseLeftButtonUp">
                <Grid>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FF0000" Offset="0"/>
                                <GradientStop Color="#FFFF00" Offset="0.1667"/>
                                <GradientStop Color="#00FF00" Offset="0.3333"/>
                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                <GradientStop Color="#0000FF" Offset="0.6667"/>
                                <GradientStop Color="#FF00FF" Offset="0.8333"/>
                                <GradientStop Color="#FF0000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Border x:Name="HueThumb" Width="22" Height="12" CornerRadius="4"
                            Background="White" BorderBrush="#FF000000" BorderThickness="1.2"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="HueThumbTransform"/>
                        </Border.RenderTransform>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 预设色板 -->
        <TextBlock x:Name="PresetLabel" FontSize="11" Opacity="0.6" Margin="0,16,0,6"/>
        <WrapPanel x:Name="PresetPanel" HorizontalAlignment="Left"/>

        <!-- R/G/B 精确输入 -->
        <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
            <TextBlock Text="R" Width="14" VerticalAlignment="Center" Opacity="0.6"/>
            <TextBox x:Name="RedBox" Width="58" Padding="6,5" FontFamily="Consolas"
                     KeyDown="RgbBox_KeyDown" LostFocus="RgbBox_LostFocus"/>
            <TextBlock Text="G" Width="14" VerticalAlignment="Center" Opacity="0.6"/>
            <TextBox x:Name="GreenBox" Width="58" Padding="6,5" FontFamily="Consolas"
                     KeyDown="RgbBox_KeyDown" LostFocus="RgbBox_LostFocus"/>
            <TextBlock Text="B" Width="14" VerticalAlignment="Center" Opacity="0.6"/>
            <TextBox x:Name="BlueBox" Width="58" Padding="6,5" FontFamily="Consolas"
                     KeyDown="RgbBox_KeyDown" LostFocus="RgbBox_LostFocus"/>
        </ikw:SimpleStackPanel>
    </StackPanel>
</UserControl>